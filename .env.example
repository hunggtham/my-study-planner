VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional but recommended for the public English page.
# Set this to YOUR Supabase auth.users UUID so public visitors can see your saved progress.
# You can find it in Supabase Dashboard -> Authentication -> Users.
VITE_STUDY_OWNER_ID=your_supabase_user_uuid

# Optional: Set this to the production domain for accurate public share links
# VITE_PUBLIC_APP_URL=https://your-production-domain.com
